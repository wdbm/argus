    def _selected_summary(self):
        n = len(self.selected_directories)
        if n == 0: return "(none)"
        if n == 1: return list(self.selected_directories)[0]
        return f"{n} directories"

    def _refresh_selection_ui(self):
        self.selected_var.set(self._selected_summary())
        self._refresh_recent_button_states()
        self._update_save_state()


    def _refresh_parent_status(self):
        if hasattr(self.master, "_refresh_status_recents"):
            self.master._refresh_status_recents()

    def _focus_is_text_input(self):
        focus = self.focus_get()
        if focus is None:
            return False
        return focus.winfo_class() in {"Entry", "TEntry", "Text", "Spinbox"}

    def _focus_next_widget(self, event=None):
        current = self.focus_get() or self
        target = current.tk_focusNext()
        if target is not None:
            target.focus_set()
        return "break"

    def _focus_previous_widget(self, event=None):
        current = self.focus_get() or self
        target = current.tk_focusPrev()
        if target is not None:
            target.focus_set()
        return "break"

    def _bind_escape_to_widget(self, widget):
        widget.bind("<Escape>", self._cancel, add="+")

    def _restore_focus_to_dialog(self):
        if self._is_closing or not self.winfo_exists():
            return
        self.lift()
        self.focus_force()
        self.fn_entry.focus_force()
        if self._focus_restore_job is not None:
            try:
                self.after_cancel(self._focus_restore_job)
            except Exception:
                pass
        # Some window managers restore focus late after a modal or transient
        # dialog is mapped; reassert focus once more shortly after open/return.
        self._focus_restore_job = self.after(80, self._restore_focus_to_dialog_once)

    def _restore_focus_to_dialog_once(self):
        self._focus_restore_job = None
        if self._is_closing or not self.winfo_exists():
            return
        self.lift()
        self.focus_force()
        self.fn_entry.focus_force()

    def _sync_recent_buttons_scrollregion(self, event=None):
        self.recent_buttons_canvas.configure(scrollregion=self.recent_buttons_canvas.bbox("all"))

    def _resize_recent_buttons_window(self, event=None):
        if event is None:
            return
        self.recent_buttons_canvas.itemconfigure(self._recent_buttons_window, width=event.width)

    def _sync_recent_buttons_canvas_width(self):
        self.btn_frame.update_idletasks()
        self.recent_buttons_canvas.configure(width=max(1, self.btn_frame.winfo_reqwidth()))

    def _scroll_recent_buttons_on_mousewheel(self, event=None):
        if event is None:
            return None
        if hasattr(event, "delta") and event.delta:
            direction = -1 if event.delta > 0 else 1
        elif getattr(event, "num", None) == 4:
            direction = -1
        elif getattr(event, "num", None) == 5:
            direction = 1
        else:
            return None
        self.recent_buttons_canvas.yview_scroll(direction, "units")
        return "break"

    def _listed_recent_directories(self):
        recents = all_recents()
        if self.recent_directory_listing_mode_var.get() == RECENT_DIRECTORY_LISTING_MODE_ALPHABETICAL:
            return sorted(recents, key=lambda path: str(path).casefold())
        return recents

    def _recent_directory_for_key(self, key: int):
        for display_key, path in zip(RECENT_DIRECTORY_KEYS, self._listed_recent_directories()[:MAX_INDEXED_RECENTS]):
            if display_key == key:
                return path
        return None

    def _change_recent_directory_listing_mode(self):
        self._store_recent_directory_listing_mode()
        self._render_recent_buttons()

    def _configure_recent_button_state(self, path: str):
        button = self.recent_directory_buttons.get(path)
        if button is None:
            return
        active = path in self.selected_directories
        button.configure(
            relief=("sunken" if active else "raised"),
            bg=(RECENT_DIRECTORY_BUTTON_SELECTED_BG if active else button.master.cget("bg")),
            activebackground=(
                RECENT_DIRECTORY_BUTTON_SELECTED_ACTIVE_BG
                if active else button.master.cget("bg")
            ),
        )

    def _refresh_recent_button_states(self):
        for path in self.recent_directory_buttons:
            self._configure_recent_button_state(path)

    def _render_recent_buttons(self):
        for w in self.btn_frame.winfo_children():
            w.destroy()
        self.recent_directory_buttons.clear()
        self.recent_directory_empty_label = None
        columns = max(1, int(RECENT_DIRECTORY_BUTTON_COLUMNS))
        for column in range(columns):
            self.btn_frame.grid_columnconfigure(column, weight=1)
        recents = self._listed_recent_directories()
        if not recents:
            self.recent_directory_empty_label = tk.Label(self.btn_frame, text="(No recent directories yet)")
            self.recent_directory_empty_label.pack()
            return
        for position, p in enumerate(recents):
            column, row = (position % columns), (position // columns)
            path = str(p)
            short = p.name or path
            if position < MAX_INDEXED_RECENTS:
                display_key = RECENT_DIRECTORY_KEYS[position]
                text = f"[{display_key}] {short}\n{path}"
            else:
                text = f"{short}\n{path}"
            button_kwargs = {
                "text": text,
                "justify": "left",
                "anchor": "w",
                "width": max(1, int(RECENT_DIRECTORY_BUTTON_WIDTH)),
                "relief": "raised",
                "command": lambda pp=path: self._toggle_dir(pp),
            }
            b = tk.Button(self.btn_frame, **button_kwargs)
            self._bind_escape_to_widget(b)
            b.bind("<MouseWheel>", self._scroll_recent_buttons_on_mousewheel, add="+")
            b.bind("<Button-4>", self._scroll_recent_buttons_on_mousewheel, add="+")
            b.bind("<Button-5>", self._scroll_recent_buttons_on_mousewheel, add="+")
            b.grid(row=row, column=column, padx=4, pady=4, sticky="ew")
            self.recent_directory_buttons[path] = b
            self._configure_recent_button_state(path)
        self._sync_recent_buttons_canvas_width()

    def _toggle_dir(self, path):
        if path in self.selected_directories:
            self.selected_directories.remove(path)
        else:
            self.selected_directories.add(path)
        self.selected_var.set(self._selected_summary())
        self._configure_recent_button_state(path)
        self._update_save_state()

    def _toggle_index(self, idx: int):
        if self._focus_is_text_input():
            return None
        target_directory = self._recent_directory_for_key(idx)
        if target_directory is None:
            return "break"
        self._toggle_dir(str(target_directory))
        return "break"

    def _browse_start_directory(self) -> str | None:
        if self.selected_directories:
            start_directory = Path(sorted(self.selected_directories)[0]).resolve()
        elif self.browse_initial_directory is not None:
            start_directory = self.browse_initial_directory
        else:
            return None
        if bool(self.open_parent_directory_var.get()):
            parent_directory = start_directory.parent
            if parent_directory != start_directory:
                start_directory = parent_directory
        return str(start_directory)

    def _browse(self):
        initial_directory = self._browse_start_directory()
        self.grab_release()
        try:
            schedule_directory_chooser_resize(self)
            d = filedialog.askdirectory(
                parent=self,
                title="Choose a directory to save to",
                initialdir=initial_directory,
            )
        finally:
            self.grab_set()
            self._restore_focus_to_dialog()
        if d:
            resolved_directory = Path(d).resolve()
            self.browse_initial_directory = resolved_directory
            add_recent_dir(str(resolved_directory))
            self.selected_directories.add(str(resolved_directory))
            self._render_recent_buttons()
            self._refresh_selection_ui()
            self._refresh_parent_status()

    def _update_save_state(self):
        self.save_btn.config(state=("normal" if self.selected_directories else "disabled"))

    def _clear_recents(self):
        if messagebox.askyesno("Clear recent directories", "Clear the recent directories list?", parent=self):
            clear_recents()
            self.selected_directories.clear()
            self._render_recent_buttons()
            self._refresh_selection_ui()
            self._refresh_parent_status()
        self._restore_focus_to_dialog()

    def _deselect_directories(self):
        if self.selected_directories:
            self.selected_directories.clear()
            self._refresh_selection_ui()
        self._restore_focus_to_dialog()

    def _store_move_state(self):
        if self.on_move_state_change is not None:
            self.on_move_state_change(bool(self.move_var.get()))

    def _store_overwrite_state(self):
        if self.on_overwrite_state_change is not None:
            self.on_overwrite_state_change(bool(self.overwrite_var.get()))

    def _store_open_parent_directory_state(self):
        if self.on_open_parent_directory_state_change is not None:
            self.on_open_parent_directory_state_change(bool(self.open_parent_directory_var.get()))

    def _store_recent_directory_listing_mode(self):
        if self.on_recent_directory_listing_mode_change is not None:
            self.on_recent_directory_listing_mode_change(self.recent_directory_listing_mode_var.get())

    def _close_dialog(self):
        self._is_closing = True
        if self._focus_restore_job is not None:
            try:
                self.after_cancel(self._focus_restore_job)
            except Exception:
                pass
            self._focus_restore_job = None
        self._store_move_state()
        self._store_overwrite_state()
        self._store_open_parent_directory_state()
        self._store_recent_directory_listing_mode()
        self.grab_release()
        self.destroy()

    def _save_to_index(self, idx: int):
        target_directory = self._recent_directory_for_key(idx)
        if target_directory is None:
            return "break"
        name = sanitise_filename(self.fn_var.get())
        if not name:
            messagebox.showerror("Invalid name", "Please enter a filename.", parent=self)
            return "break"
        move_requested = bool(self.move_var.get())
        overwrite_requested = bool(self.overwrite_var.get())
        self._close_dialog()
        self.on_save([target_directory], name, move_requested, overwrite_requested)
        return "break"

    def _handle_save_keypress(self, event=None):
        if self._focus_is_text_input():
            return None
        self._do_save()
        return "break"

    def _trigger_save_button(self, event=None):
        if str(self.save_btn.cget("state")) != "disabled":
            self.save_btn.invoke()
        return "break"

    def _do_save(self):
        if not self.selected_directories:
            messagebox.showwarning("Choose directories", "Please select at least one directory.", parent=self)
            return
        name = sanitise_filename(self.fn_var.get())
        if not name:
            messagebox.showerror("Invalid name", "Please enter a filename.", parent=self)
            return
        move_requested = bool(self.move_var.get())
        overwrite_requested = bool(self.overwrite_var.get())
        self._close_dialog()
        directories = [Path(p).resolve() for p in self.selected_directories]
        self.on_save(directories, name, move_requested, overwrite_requested)

    def _cancel(self, event=None):
        self._close_dialog()
        return "break"

