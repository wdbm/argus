# recents --------------------------------------------------------------

def set_configuration_directory(directory):
    global CONFIGURATION_DIRECTORY, RECENTS_FILE, RECENT_DIRECTORY_STORE
    CONFIGURATION_DIRECTORY = Path(directory).expanduser()
    CONFIGURATION_DIRECTORY.mkdir(parents=True, exist_ok=True)
    RECENTS_FILE = CONFIGURATION_DIRECTORY / "recent_directories.json"
    RECENT_DIRECTORY_STORE = RecentDirectoryStore(RECENTS_FILE, max_recents=MAX_RECENTS)

def load_recents():
    return RECENT_DIRECTORY_STORE.load()

def save_recents(recents):
    RECENT_DIRECTORY_STORE.save(recents)

def clear_recents():
    RECENT_DIRECTORY_STORE.clear()

def add_recent_dir(path_str):
    return RECENT_DIRECTORY_STORE.add(path_str)

def most_recent_dir():
    return RECENT_DIRECTORY_STORE.most_recent()

def all_recents():
    return RECENT_DIRECTORY_STORE.all()

def indexed_recents():
    return list(zip(RECENT_DIRECTORY_KEYS, all_recents()[:MAX_INDEXED_RECENTS]))

def recent_dir_for_key(key: int):
    for display_key, path in indexed_recents():
        if display_key == key:
            return path
    return None

def schedule_directory_chooser_resize(
    parent,
    width_scale: int = DIRECTORY_CHOOSER_WIDTH_SCALE,
    height_scale: int = DIRECTORY_CHOOSER_HEIGHT_SCALE
):
    if parent.tk.call("tk", "windowingsystem") != "x11":
        return

    chooser_path = f"{str(parent)}.__tk_choosedir" if str(parent) != "." else ".__tk_choosedir"
    parent.tk.eval(
        f"""
        namespace eval ::argus::dialogue {{}}
        proc ::argus::dialogue::resize_directory_chooser {{w parent width_scale height_scale retries}} {{
            if {{$retries <= 0}} {{
                return
            }}
            if {{![winfo exists $w]}} {{
                after 20 [list ::argus::dialogue::resize_directory_chooser $w $parent $width_scale $height_scale [expr {{$retries - 1}}]]
                return
            }}
            update idletasks
            set base_width [winfo reqwidth $w]
            set base_height [winfo reqheight $w]
            if {{$base_width <= 1 || $base_height <= 1}} {{
                after 20 [list ::argus::dialogue::resize_directory_chooser $w $parent $width_scale $height_scale [expr {{$retries - 1}}]]
                return
            }}
            set screen_width [winfo screenwidth $w]
            set screen_height [winfo screenheight $w]
            set target_width [expr {{min(int(round($base_width * $width_scale)), max(200, $screen_width - {DIRECTORY_CHOOSER_SCREEN_MARGIN}))}}]
            set target_height [expr {{min(int(round($base_height * $height_scale)), max(200, $screen_height - {DIRECTORY_CHOOSER_SCREEN_MARGIN}))}}]
            if {{[winfo exists $parent]}} {{
                set parent_x [winfo rootx $parent]
                set parent_y [winfo rooty $parent]
                set parent_width [winfo width $parent]
                set parent_height [winfo height $parent]
                set x [expr {{$parent_x + (($parent_width - $target_width) / 2)}}]
                set y [expr {{$parent_y + (($parent_height - $target_height) / 2)}}]
            }} else {{
                set x [expr {{($screen_width - $target_width) / 2}}]
                set y [expr {{($screen_height - $target_height) / 2}}]
            }}
            set x [expr {{max(0, min($x, $screen_width - $target_width))}}]
            set y [expr {{max(0, min($y, $screen_height - $target_height))}}]
            wm minsize $w $base_width $base_height
            wm geometry $w "${{target_width}}x${{target_height}}+${{x}}+${{y}}"
        }}
        """
    )
    parent.tk.call(
        "after",
        "idle",
        "::argus::dialogue::resize_directory_chooser",
        chooser_path,
        str(parent),
        width_scale,
        height_scale,
        50,
    )

# utilities ------------------------------------------------------------

def is_supported_image_path(path: Path) -> bool:
    return path.is_file() and path.suffix.lower() in SUPPORTED_IMAGE_SUFFIXES

def resolve_input_target(path_str: str) -> tuple[Path, Path | None]:
    path = Path(path_str).expanduser().resolve()
    if not path.exists():
        raise ValueError(f"path does not exist: {path}")
    if path.is_dir():
        return path, None
    if is_supported_image_path(path):
        return path.parent, path
    if path.is_file():
        raise ValueError(f"file type is not supported: {path}")
    raise ValueError(f"path is neither a regular file nor a directory: {path}")

def collect_image_paths(directory: Path):
    try:
        return sorted([path for path in directory.iterdir() if is_supported_image_path(path)])
    except OSError as exc:
        raise ValueError(f"could not inspect directory: {directory} ({exc})") from exc

def svg_backend_available() -> bool:
    return (Rsvg is not None and cairo is not None) or cairosvg is not None

def _svg_length_to_pixels(length):
    if Rsvg is None:
        return None
    scale_by_unit = {
        Rsvg.Unit.PX: 1.0,
        Rsvg.Unit.PT: SVG_RENDER_DPI / 72.0,
        Rsvg.Unit.PC: SVG_RENDER_DPI / 6.0,
        Rsvg.Unit.MM: SVG_RENDER_DPI / 25.4,
        Rsvg.Unit.CM: SVG_RENDER_DPI / 2.54,
        Rsvg.Unit.IN: float(SVG_RENDER_DPI),
    }
    scale = scale_by_unit.get(length.unit)
    if scale is None:
        return None
    value = float(length.length) * scale
    return value if value > 0 else None

def _svg_intrinsic_size(handle) -> tuple[float, float]:
    width = None
    height = None
    viewbox_width = None
    viewbox_height = None

    try:
        has_width, width_length, has_height, height_length, has_viewbox, viewbox = handle.get_intrinsic_dimensions()
        if has_width:
            width = _svg_length_to_pixels(width_length)
        if has_height:
            height = _svg_length_to_pixels(height_length)
        if has_viewbox and viewbox.width > 0 and viewbox.height > 0:
            viewbox_width = float(viewbox.width)
            viewbox_height = float(viewbox.height)
    except Exception:
        pass

    if viewbox_width and viewbox_height:
        if width is None and height is not None:
            width = height * (viewbox_width / viewbox_height)
        elif height is None and width is not None:
            height = width * (viewbox_height / viewbox_width)
        elif width is None and height is None:
            width = viewbox_width
            height = viewbox_height

    if width is None or height is None:
        try:
            dimensions = handle.get_dimensions()
            if width is None and dimensions.width > 0:
                width = float(dimensions.width)
            if height is None and dimensions.height > 0:
                height = float(dimensions.height)
        except Exception:
            pass

    if width is None and height is None:
        width = float(SVG_FALLBACK_RENDER_SIDE)
        height = float(SVG_FALLBACK_RENDER_SIDE)
    elif width is None:
        width = float(height)
    elif height is None:
        height = float(width)

    return max(1.0, width), max(1.0, height)

def _svg_render_size(handle) -> tuple[int, int]:
    intrinsic_width, intrinsic_height = _svg_intrinsic_size(handle)
    longest_side = max(intrinsic_width, intrinsic_height)
    scale = 1.0
    if longest_side < SVG_DEFAULT_RENDER_LONG_SIDE:
        scale = SVG_DEFAULT_RENDER_LONG_SIDE / longest_side
    elif longest_side > MAX_RENDER_SIDE:
        scale = MAX_RENDER_SIDE / longest_side
    return (
        max(1, int(round(intrinsic_width * scale))),
        max(1, int(round(intrinsic_height * scale))),
    )

# threaded image cache -------------------------------------------------

@dataclass
class CachedFrame:
    image: Image.Image
    mipmaps: list[Image.Image]

@dataclass
class CachedImageData:
    frames: list[CachedFrame]
    durations_ms: list[int]
    loop: int | None = None

    @property
    def is_animated(self) -> bool:
        return len(self.frames) > 1

class ImageCache:
    """Small LRU cache of decoded PIL Images + mipmaps, loaded off-thread."""
    def __init__(self, max_items=CACHE_MAX_ITEMS, workers=2):
        self.max_items = max_items
        self.cache = OrderedDict()
        self.futures: dict[Path, Future] = {}
        self.pool = ThreadPoolExecutor(max_workers=workers)
        self.completed = SimpleQueue()
        self.closed = False

    def _close_frame(self, frame: CachedFrame):
        try:
            frame.image.close()
        except Exception:
            pass
        for mip in frame.mipmaps:
            try:
                mip.close()
            except Exception:
                pass

    def _close_result(self, data: CachedImageData):
        for frame in data.frames:
            self._close_frame(frame)

    def _build_mipmaps(self, base: Image.Image):
        mipmaps = []
        w, h = base.size
        while True:
            w //= 2; h //= 2
            if w < 1 or h < 1: break
            if min(w, h) < MIPMAP_MIN_SIDE: break
            lvl = base.resize((w, h), Image.Resampling.LANCZOS)
            mipmaps.append(lvl)
        return mipmaps

    def _load_svg_via_librsvg(self, path: Path):
        if Rsvg is None or cairo is None:
            raise RuntimeError("SVG support requires librsvg and pycairo.")
        handle = Rsvg.Handle.new_from_file(str(path))
        render_width, render_height = _svg_render_size(handle)
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, render_width, render_height)
        context = cairo.Context(surface)
        viewport = Rsvg.Rectangle()
        viewport.x = 0
        viewport.y = 0
        viewport.width = render_width
        viewport.height = render_height
        context.set_source_rgba(0, 0, 0, 0)
        context.paint()
        ok = handle.render_document(context, viewport)
        if ok is False:
            raise RuntimeError("librsvg could not render the SVG document.")
        png_buffer = BytesIO()
        surface.write_to_png(png_buffer)
        png_buffer.seek(0)
        with Image.open(png_buffer) as im:
            im.load()
            frame = im.copy()
        if frame.mode not in {"RGB", "RGBA"}:
            frame = frame.convert("RGBA")
        return CachedImageData(
            frames=[CachedFrame(frame, self._build_mipmaps(frame))],
            durations_ms=[0],
        )

    def _load_svg_via_cairosvg(self, path: Path):
        if cairosvg is None:
            raise RuntimeError("SVG support requires either librsvg or CairoSVG.")
        png_bytes = cairosvg.svg2png(url=str(path), dpi=SVG_RENDER_DPI)
        with Image.open(BytesIO(png_bytes)) as im:
            im.load()
            frame = im.copy()
        if frame.mode not in {"RGB", "RGBA"}:
            frame = frame.convert("RGBA")
        return CachedImageData(
            frames=[CachedFrame(frame, self._build_mipmaps(frame))],
            durations_ms=[0],
        )

    def _load_raster_image(self, path: Path):
        with Image.open(path) as im:
            format_name = str(getattr(im, "format", "") or "").upper()
            frame_count = max(1, getattr(im, "n_frames", 1))
            # Some phone "JPEG" files are exposed by Pillow as MPO containers with
            # auxiliary frames. Decoding those extra frames can fail even though the
            # primary image is valid, so treat MPOs as still images.
            is_animated = bool(
                format_name != "MPO"
                and getattr(im, "is_animated", False)
                and frame_count > 1
            )
            frames: list[CachedFrame] = []
            durations_ms: list[int] = []

            if is_animated:
                for frame_index in range(frame_count):
                    im.seek(frame_index)
                    im.load()
                    frame = im.copy()
                    if frame.mode not in {"RGB", "RGBA"}:
                        frame = frame.convert("RGBA")
                    frames.append(CachedFrame(frame, self._build_mipmaps(frame)))
                    duration_ms = int(im.info.get("duration", 100) or 100)
                    durations_ms.append(max(MINIMUM_ANIMATION_FRAME_MS, duration_ms))
            else:
                im.load()
                frame = im.copy()
                frames.append(CachedFrame(frame, self._build_mipmaps(frame)))
                durations_ms.append(0)

            return CachedImageData(
                frames=frames,
                durations_ms=durations_ms,
                loop=im.info.get("loop"),
            )

    def _load_image(self, path: Path):
        if path.suffix.lower() == ".svg":
            if Rsvg is not None and cairo is not None:
                return self._load_svg_via_librsvg(path)
            if cairosvg is not None:
                return self._load_svg_via_cairosvg(path)
            raise ValueError("SVG support is unavailable. Install librsvg/pycairo or CairoSVG.")
        return self._load_raster_image(path)

    def _store_completed(self, path: Path, fut: Future):
        if self.closed:
            try:
                self._close_result(fut.result())
            except Exception:
                pass
            return
        self.completed.put((path, fut))

    def process_completed(self):
        while True:
            try:
                path, fut = self.completed.get_nowait()
            except Empty:
                return

            if self.closed:
                try:
                    self._close_result(fut.result())
                except Exception:
                    pass
                continue

            if self.futures.get(path) is not fut:
                try:
                    self._close_result(fut.result())
                except Exception:
                    pass
                continue

            self.futures.pop(path, None)
            try:
                data = fut.result()
            except Exception:
                continue
            self.cache[path] = data
            while len(self.cache) > self.max_items:
                _, evicted = self.cache.popitem(last=False)
                self._close_result(evicted)

    def request(self, path: Path) -> Future:
        self.process_completed()
        path = path.resolve()
        if path in self.cache:
            data = self.cache.pop(path)
            self.cache[path] = data
            f = Future()
            f.set_result(data)
            return f
        if path in self.futures:
            return self.futures[path]

        fut = self.pool.submit(self._load_image, path)
        self.futures[path] = fut
        fut.add_done_callback(lambda _f, p=path: self._store_completed(p, _f))
        return fut

    def discard(self, path: Path):
        self.process_completed()
        path = path.resolve()
        fut = self.futures.pop(path, None)
        if fut and not fut.done():
            fut.cancel()
        data = self.cache.pop(path, None)
        if data:
            self._close_result(data)

    def shutdown(self):
        self.closed = True
        self.process_completed()
        for fut in list(self.futures.values()):
            if not fut.done():
                fut.cancel()
        self.pool.shutdown(wait=False)
        for _, data in list(self.cache.items()):
            self._close_result(data)
        self.cache.clear()
        self.futures.clear()

