class RecentSaveDialog(Toplevel):
    """
    multi-select dialogue with:
      - filename entry (pre-filled, editable)
      - toggle buttons for up to 60 recent directories (multi-select)
      - radio buttons to list recent directories alphabetically or by recency
      - digit keys 1-9,0: toggle the indexed recent directories
      - Browse... to add/select a directory
      - Move checkbutton for removing the original after transfer
      - Overwrite checkbutton for replacing existing files with the same name
      - Open parent directory checkbutton for browsing from the parent of the default start directory
      - Escape: close the dialogue
      - Return: trigger the Save button
      - Save button writes to all selected directories + filename
      - clear recent directories
      - Alt+digit keys 1-9,0: immediate save to that indexed recent directory
    """
    def __init__(
        self,
        master,
        on_save,
        default_filename: str,
        last_selected=None,
        browse_initial_directory: Path | None = None,
        move_selected: bool = False,
        on_move_state_change=None,
        overwrite_selected: bool = False,
        on_overwrite_state_change=None,
        open_parent_directory_selected: bool = True,
        on_open_parent_directory_state_change=None,
        recent_directory_listing_mode: str = RECENT_DIRECTORY_LISTING_MODE_ALPHABETICAL,
        on_recent_directory_listing_mode_change=None,
    ):
        super().__init__(master)
        self.title("Save to...")
        self.resizable(False, False)
        self.on_save = on_save
        self.on_move_state_change = on_move_state_change
        self.on_overwrite_state_change = on_overwrite_state_change
        self.on_open_parent_directory_state_change = on_open_parent_directory_state_change
        self.on_recent_directory_listing_mode_change = on_recent_directory_listing_mode_change
        self.configure(padx=12, pady=12)
        self.transient(master)
        self.grab_set()
        self._focus_restore_job = None
        self._is_closing = False
        self.selected_directories = set(str(Path(p).resolve()) for p in (last_selected or []))
        self.recent_directory_buttons: dict[str, tk.Button] = {}
        self.recent_directory_empty_label: tk.Label | None = None
        self.browse_initial_directory = (Path(browse_initial_directory).resolve() if browse_initial_directory else None)
        self.move_var = tk.BooleanVar(value=move_selected)
        self.overwrite_var = tk.BooleanVar(value=overwrite_selected)
        self.open_parent_directory_var = tk.BooleanVar(value=open_parent_directory_selected)
        self.recent_directory_listing_mode_var = tk.StringVar(
            value=(
                recent_directory_listing_mode
                if recent_directory_listing_mode in {
                    RECENT_DIRECTORY_LISTING_MODE_ALPHABETICAL,
                    RECENT_DIRECTORY_LISTING_MODE_MOST_RECENT,
                }
                else RECENT_DIRECTORY_LISTING_MODE_ALPHABETICAL
            )
        )

        # filename row
        fn_frame = tk.Frame(self); fn_frame.grid(row=0, column=0, sticky="ew", pady=(0, 8))
        tk.Label(fn_frame, text="Filename:").pack(side="left")
        self.fn_var = tk.StringVar(value=default_filename)
        self.fn_entry = tk.Entry(fn_frame, textvariable=self.fn_var, width=48)
        self.fn_entry.pack(side="left", padx=(6, 0))

        # recents header
        hdr = tk.Frame(self); hdr.grid(row=1, column=0, sticky="ew")
        tk.Label(hdr, text="Recent directories (1-9,0 for first 10 shown)", font=("TkDefaultFont", 10, "bold")).pack(side="left")
        clear_recents_btn = tk.Button(hdr, text="Clear recent directories", command=self._clear_recents)
        clear_recents_btn.pack(side="right")
        self._bind_escape_to_widget(clear_recents_btn)
        cancel_btn = tk.Button(hdr, text="Cancel", command=self._cancel)
        cancel_btn.pack(side="right", padx=(0, 6))
        self._bind_escape_to_widget(cancel_btn)
        sort_frame = tk.Frame(hdr)
        sort_frame.pack(side="right", padx=(0, 10))
        alphabetical_btn = tk.Radiobutton(
            sort_frame,
            text="List alphabetically",
            variable=self.recent_directory_listing_mode_var,
            value=RECENT_DIRECTORY_LISTING_MODE_ALPHABETICAL,
            command=self._change_recent_directory_listing_mode,
        )
        alphabetical_btn.pack(side="left")
        self._bind_escape_to_widget(alphabetical_btn)
        most_recent_btn = tk.Radiobutton(
            sort_frame,
            text="List by most recent",
            variable=self.recent_directory_listing_mode_var,
            value=RECENT_DIRECTORY_LISTING_MODE_MOST_RECENT,
            command=self._change_recent_directory_listing_mode,
        )
